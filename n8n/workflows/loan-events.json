    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\n\n// Names are user-controlled and go into a chat message: strip mentions and markdown.\nconst clean = (s) => String(s ?? '').replace(/[@`*_~|>\\[\\]()<\\\\]/g, '').trim().slice(0, 60);\nconst fmt = (ms) =>\n  new Date(ms).toLocaleString('en-GB', {\n    timeZone: 'Africa/Addis_Ababa',\n    dateStyle: 'medium',\n    timeStyle: 'short',\n  });\n\nconst other = clean(e.otherName);\nconst tool = clean(e.toolName);\nconst when = `${fmt(e.startDate)} to ${fmt(e.endDate)}`;\n\nconst templates = {\n  created: `${other} would like to borrow your ${tool} (${when}).`,\n  approved: `${other} approved your request for ${tool} (${when}).`,\n  declined: `${other} declined your request for ${tool}.`,\n  auto_declined: `your request for ${tool} (${when}) could not go ahead, because it was lent to someone else for those dates.`,\n  cancelled: `${other} cancelled their request for your ${tool}.`,\n  returned: `${other} marked ${tool} as returned. You can now leave a rating.`,\n};\n\nconst body = templates[e.event];\nif (!body) {\n  return [{ json: { ok: false, reason: 'unsupported_event', event: String(e.event).slice(0, 40) } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    idempotencyKey: e.idempotencyKey,\n    event: e.event,\n    to: clean(e.recipientName),\n    message: `Hi ${clean(e.recipientName)}, ${body}`,\n  },\n}];"
      },
