      "parameters": {
        "jsCode": "const TTL_MS = 24 * 60 * 60 * 1000;\nconst data = $getWorkflowStaticData('global');\nconst seen = data.seen || {};\nconst now = Date.now();\n\n// Prune old keys so the store cannot grow forever.\nfor (const [key, at] of Object.entries(seen)) {\n  if (now - at > TTL_MS) delete seen[key];\n}\ndata.seen = seen;\n\nconst event = $input.first().json;\nreturn [{ json: { ...event, duplicate: Boolean(seen[event.idempotencyKey]) } }];"
