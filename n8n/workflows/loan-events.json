    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst MAX_AGE_MS = 5 * 60 * 1000; // replay window (D48)\nconst fail = (reason) => [{ json: { ok: false, reason } }];\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\n\nif (!secret) return fail('secret_not_configured');\n\nconst timestamp = headers['x-lendloop-timestamp'];\nconst signatureHeader = headers['x-lendloop-signature'] || '';\nif (!timestamp || !signatureHeader.startsWith('sha256=')) {\n  return fail('missing_headers');\n}\nif (!/^\\d+$/.test(timestamp) || Math.abs(Date.now() - Number(timestamp)) > MAX_AGE_MS) {\n  return fail('stale_or_invalid_timestamp');\n}\n\n// Hash the exact bytes that arrived, not a re-serialized copy.\nconst rawBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst raw = rawBuffer.toString('utf8');\n\nconst expected = Buffer.from(\n  crypto.createHmac('sha256', secret).update(`${timestamp}.${raw}`).digest('hex'),\n  'hex',\n);\nconst given = Buffer.from(signatureHeader.slice('sha256='.length), 'hex');\n\n// Constant-time comparison.\nif (expected.length !== given.length || !crypto.timingSafeEqual(expected, given)) {\n  return fail('bad_signature');\n}\n\n// Only parse the body after the signature is proven valid.\nreturn [{ json: { ok: true, ...JSON.parse(raw) } }];"
      },
